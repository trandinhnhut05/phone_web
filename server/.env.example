PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL with Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/phone_web?schema=public"

# Auth
JWT_SECRET=super_secret_jwt_key_phone_web_2026
JWT_EXPIRES_IN=7d

# Cloudinary (Optional - has local upload fallback if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / Nodemailer (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=admin@phoneweb.com
